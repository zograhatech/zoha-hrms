# ==============================================================================
# Hari HRMS - Backend Environment Variables Template
# File Location: hrms-hari/HRMS/backend/.env
# NOTE: Do NOT commit actual .env files containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for local backend HTTP server (defaults to 5000 if omitted)
PORT=5000

# Node runtime environment (development | production)
NODE_ENV=development

# Frontend application URL for CORS whitelist and email links
# In local development: http://localhost:5173
# In production: https://zoha-hrms-cwie.vercel.app
FRONTEND_URL=https://zoha-hrms-cwie.vercel.app

# Additional CORS Allowed Origins (optional, comma-separated)
# Automatically whitelists Vercel preview URLs matching ^https://zoha-hrms-cwie(-git-[a-z0-9-]+)?(-[a-z0-9]+)?(-zograha)?\.vercel\.app$
# Add any extra custom domains here:
# ALLOWED_ORIGINS=https://custom-domain.com,https://staging.zograha.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Local MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (supports MONGODB_URI or MONGO_URI)
# For remote MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hrms_db?retryWrites=true&w=majority
# For local MongoDB instance:
# MONGODB_URI=mongodb://localhost:27017/hrms_db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key for signing 15-minute access tokens (use a long random 64-char string)
JWT_SECRET=your_jwt_access_secret_key_change_me_in_production

# Secret key for signing refresh tokens (30d / 1d lifespan)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me_in_production

# ------------------------------------------------------------------------------
# 4. MEDIA & FILE STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Required for uploading profile pictures, logos, resumes, and chat attachments
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Web push notification keys generated via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@example.com

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS (Zoom & Encryption)
# ------------------------------------------------------------------------------
# 32-character (256-bit) encryption key used for encrypting Zoom S2S credentials in DB
# Default fallback in code: 12345678901234567890123456789012
ZOOM_ENCRYPTION_KEY=12345678901234567890123456789012

# ------------------------------------------------------------------------------
# 7. HOSTED REALTIME MESSAGING (Pusher Channels)
# ------------------------------------------------------------------------------
# Optional: Used for private realtime chat and status sync in serverless environments
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2

# ------------------------------------------------------------------------------
# 8. LARGE FILE STORAGE (Cloudflare R2 / AWS S3 Multipart)
# ------------------------------------------------------------------------------
# Presigned chunked multipart uploads for large files (supports up to 2 GB+)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
# Maximum upload byte size limit (default: 2147483648 = 2 GB)
MAX_UPLOAD_BYTES=2147483648

# ------------------------------------------------------------------------------
# 9. ATTENDANCE SWEEPER & CRON
# ------------------------------------------------------------------------------
# Bearer secret required to trigger POST /api/attendance/sweep-idle-sessions
SWEEPER_SECRET=your_random_sweeper_secret_token
CRON_SECRET=your_vercel_cron_secret

# ------------------------------------------------------------------------------
# 10. SUPER ADMIN CHAT OVERSIGHT ALLOWLIST
# ------------------------------------------------------------------------------
# Optional: Explicit comma-separated emails or employee IDs allowed Super Admin chat oversight
SUPER_ADMIN_ALLOWLIST=admin@zograha.com,EMP_SUPER_01

