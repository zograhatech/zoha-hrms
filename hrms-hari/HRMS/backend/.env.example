# ==============================================================================
# HRMS Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (REQUIRED)
# MongoDB connection string (Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hrms_db?retryWrites=true&w=majority

# Authentication / Security (REQUIRED for production / Vercel)
# Strong random 64-character secrets recommended
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# CORS Allowed Origins
# Main frontend URL
CLIENT_URL=http://localhost:5173
# Additional origins (comma-separated, optional)
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.vercel.app

# Client / Company Details (Used for initial bootstrapping / branding fallback)
COMPANY_NAME=Your Company Name
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Email / SMTP Configuration (Optional - for welcome emails, leave approvals, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="HRMS Portal" <your-email@example.com>

# Zoom Integration (Optional - 32-byte hex string for AES-256-GCM token encryption)
# If omitted, Zoom module will return HTTP 503 without crashing the server
ZOOM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local Development Only: Windows DNS Override
# If running on Windows and experiencing MongoDB Atlas SRV lookup errors locally,
# place this in .env.local-dns (which is gitignored):
# DNS_SERVERS=8.8.8.8,1.1.1.1

