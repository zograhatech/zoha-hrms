# ==============================================================================
# HRMS Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and fill in the values for your environment.
# NOTE: In Vite, environment variables must start with VITE_ to be exposed to the client.
# NOTE: Changing Vite environment variables on Vercel requires a redeployment to take effect.
# ==============================================================================

# Backend API Base URL (Required for cross-project / preview deployments)
# - Local Development: http://localhost:5001
# - Production Scope: https://zoha-hrms.vercel.app
# - Preview Scope: https://zoha-hrms-git-<branch>-zograha.vercel.app (your backend preview domain)
# - Fallback (if unset): defaults to https://zoha-hrms.vercel.app
VITE_API_BASE_URL=http://localhost:5001
