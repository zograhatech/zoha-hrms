# ==============================================================================
# HRMS Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and fill in the values for your environment.
# ==============================================================================

# Backend API Base URL
# For local development with backend on port 5001:
# VITE_API_BASE_URL=http://localhost:5001
# For production deployment on Vercel:
# VITE_API_BASE_URL=https://your-backend-domain.vercel.app
# If left empty, API calls will target relative paths (/api)
VITE_API_BASE_URL=http://localhost:5001

